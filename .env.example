# Copy this file to .env and fill in real values. .env is gitignored — never commit real secrets.
#
# Every value here is per-install. Do not copy a filled-in .env from one
# customer to another: JWT_SECRET, INSTALL_ID and the database name must all
# differ, and reusing them is what lets one install's token validate on
# another's server.


# =============================================================================
# DATABASE
# =============================================================================
# Either set DATABASE_URL (a full postgres:// URL — this is what the Docker
# deploy uses and it overrides everything below), or the discrete fields.
# DATABASE_URL=postgres://user:password@host:5432/odyssey-ifa

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
# REQUIRED. There is deliberately no default — a shared fallback in a tracked
# file is exactly the thing that ends up in production untouched.
DB_PASS=

# The application database. Name it after the install, not "odyssey-prod":
# several installs on one server must not share a name.
DB_NAME=odyssey-ifa

# A SEPARATE throwaway database for `npm test`. The suite truncates Sessions and
# deletes rows, so pointing this at DB_NAME signs out every logged-in user and
# destroys data. The test bootstrap refuses to run if the two match, but set it
# correctly rather than relying on that.
DB_NAME_TEST=odyssey-ifa-suite

# Schema handling on boot (models/index.js):
#   create  default — CREATE TABLE IF NOT EXISTS, never ALTER. Safe for prod.
#   alter   applies model changes to existing tables. Run once, deliberately,
#           after an upgrade that adds columns — then set it back to create.
#   off     no schema work at all.
# Boot prints a drift warning when a model has columns the database does not.
ODYSSEY_DB_SYNC=create


# =============================================================================
# SECRETS
# =============================================================================
# REQUIRED. Signs login tokens (functions/tokenVerification.js). No fallback:
# the server refuses to start without it (except under NODE_ENV=test).
# Generate a UNIQUE value PER INSTALL:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optional: separate secret for the short-lived invoice-print token.
# Falls back to JWT_SECRET if unset.
PRINT_TOKEN_SECRET=


# =============================================================================
# LICENSING / KILL-SWITCH (functions/license/)
# =============================================================================
# Unique id for THIS install; must match what you manage on the licence server.
INSTALL_ID=

# Your cloud licence server base URL.
LICENSE_SERVER_URL=https://license.seanetpk.com

# Owner / self-hosted exemption. Set true ONLY on the install owned by the
# company that built the software — licensing becomes a no-op (always active,
# no heartbeat, never read-only) so they cannot lock themselves out.
# Leave false for every leased install, including group companies.
LICENSE_EXEMPT=false


# =============================================================================
# FIRST-LOAD ADMIN (functions/seedAdmin.js)
# =============================================================================
# On first boot with an empty Employees table an admin account is created so the
# system is usable immediately. Leave ADMIN_SEED_PASSWORD BLANK: a strong random
# password is then generated and printed to the boot log exactly once, on the
# run that creates the account. Setting it here puts a known password in a file.
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=


# =============================================================================
# EMAIL (functions/mailer.js, functions/pdf.js)
# =============================================================================
# SMTP account used to relay invoice mail. The "From" header is the sending
# employee's own address; authentication always happens as this account.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Where the backend reaches the frontend, for Puppeteer to render invoice PDFs.
# Dev: http://localhost:3000   Prod: http://localhost:3003 (or the deployed URL)
FRONTEND_BASE_URL=http://localhost:3003


# =============================================================================
# MIGRATION (only for installs replacing a legacy Climax system)
# =============================================================================
# Leave unset on a fresh install with no legacy data — the Config > Migration
# screen has nothing to talk to and should not be used.
# NEXT_PUBLIC_CLIMAX_LEGACY_URL is set on the FRONTEND, not here.
