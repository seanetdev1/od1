# =============================================================================
# Odyssey Monorepo — Environment Configuration Template
# =============================================================================
# Copy this file to:
#   1. .env                         (used by docker-compose.yml & root scripts)
#   2. odyssey-backend-server/.env  (used by the Node.js backend)
#
# Never commit real .env files to Git.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL (Docker Compose & Backend)
# -----------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
# REQUIRED: choose a strong local password before starting Docker or backend
DB_PASS=change-me-local-dev-password

# Main application database name
DB_NAME=odyssey-dev

# Separate throwaway database for automated tests (name must contain "test")
DB_NAME_TEST=odyssey-test

# Optional full connection URL (overrides discrete DB_* fields in production mode)
# DATABASE_URL=postgres://postgres:change-me-local-dev-password@127.0.0.1:5432/odyssey-dev

# Schema handling on boot (odyssey-backend-server/models/index.js):
#   create = CREATE TABLE IF NOT EXISTS only (safe default; never drops columns)
#   alter  = reconcile column changes with ALTER TABLE (run deliberately via --migrate-alter)
#   off    = skip schema sync
ODYSSEY_DB_SYNC=create

# -----------------------------------------------------------------------------
# Backend Security Secrets
# -----------------------------------------------------------------------------
# REQUIRED: generate a unique secret per install:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optional separate secret for invoice-print tokens (defaults to JWT_SECRET)
PRINT_TOKEN_SECRET=

# -----------------------------------------------------------------------------
# Licensing
# -----------------------------------------------------------------------------
INSTALL_ID=
LICENSE_SERVER_URL=https://license.seanetpk.com
# Set true ONLY for internal/owner development environments
LICENSE_EXEMPT=true

# -----------------------------------------------------------------------------
# First-Boot Admin Seed (runs only when Employees table is empty)
# -----------------------------------------------------------------------------
ADMIN_SEED_USERNAME=admin
# Leave blank to auto-generate a strong one-time password in the boot log
ADMIN_SEED_PASSWORD=

# -----------------------------------------------------------------------------
# Email (Optional — for invoice email delivery)
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# -----------------------------------------------------------------------------
# Application URLs & Ports
# -----------------------------------------------------------------------------
# Dev mode defaults:  Frontend = http://localhost:3000, Backend = http://localhost:8084
# Prod mode defaults: Frontend = http://localhost:3003, Backend = http://localhost:8088
FRONTEND_BASE_URL=http://localhost:3000
NEXT_PUBLIC_CLIMAX_MAIN_URL=http://localhost:8084
